{
  "name": "internal-medicine-question-bank",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "audit:pathology": "python3 scripts/audit_pathology_content.py",
    "audit:surgery": "python3 scripts/audit_surgery_content.py",
    "audit:surgery-hpb": "python3 scripts/audit_surgery_hpb_content.py",
    "audit:thyroid": "python3 scripts/audit_thyroid_content.py",
    "audit:fracture": "python3 scripts/audit_fracture_content.py",
    "audit:deformity": "python3 scripts/audit_deformity_content.py",
    "audit:ortho-mixed": "python3 scripts/audit_ortho_mixed_content.py",
    "audit:ortho-infection": "python3 scripts/audit_ortho_infection_content.py",
    "audit:nonpurulent-arthritis": "python3 scripts/audit_nonpurulent_arthritis_content.py",
    "audit:bone-tumor": "python3 scripts/audit_bone_tumor_content.py",
    "audit:trunk-spine": "python3 scripts/audit_trunk_spine_content.py",
    "audit:degenerative-spine": "python3 scripts/audit_degenerative_spine_content.py",
    "audit:limb-fracture": "python3 scripts/audit_limb_fracture_content.py",
    "audit:surgery-general": "python3 scripts/audit_surgery_general_content.py",
    "audit:surgery-general-core": "node scripts/audit_surgery_general_core.mjs",
    "audit:surgery-general-late": "node scripts/audit_surgery_general_late.mjs",
    "audit:content": "pnpm run audit:surgery && pnpm run audit:surgery-hpb && pnpm run audit:thyroid && pnpm run audit:fracture && pnpm run audit:deformity && pnpm run audit:ortho-mixed && pnpm run audit:ortho-infection && pnpm run audit:nonpurulent-arthritis && pnpm run audit:bone-tumor && pnpm run audit:trunk-spine && pnpm run audit:degenerative-spine && pnpm run audit:limb-fracture && pnpm run audit:surgery-general && pnpm run audit:surgery-general-core && pnpm run audit:surgery-general-late",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts && cp dist-pages/index.html dist-pages/404.html",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
