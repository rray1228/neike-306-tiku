  {"id": "xuecheng-37-20261116-q06", "topic": "氨基酸与蛋白质", "title": "37不yy老师的学成选择题", "kindLabel": "多项选择", "sourceLabel": "37不yy老师的学成选择题", "sourceName": "生化-氨基酸代谢、氨基酸", "sourceSection": "11月16日", "sourceQuestion": 6, "questionAuthor": "37不yy", "supplement": true, "hideSource": true, "answerSourceLabel": "原稿答案", "lectureIds": ["lecture-07"], "chapterLectureIds": ["lecture-07"], "options": [{"key": "A", "label": "CPS合成酶Ⅰ"}, {"key": "B", "label": "OCT"}, {"key": "C", "label": "精氨酸酶"}, {"key": "D", "label": "精氨酸代琥珀酸合成酶"}, {"key": "E", "label": "精氨酸代琥珀酸裂解酶"}], "stems": [{"text": "尿素合成中催化单向反应的酶有：（多选）", "answer": ["A", "B", "D"], "answerMode": "多选", "explanation": "按原稿选 A、B、D。CPSⅠ消耗 ATP 制成氨基甲酰磷酸，OCT 将氨甲酰基转给鸟氨酸，合集将此步标为单向。精氨酸代琥珀酸合成酶将 ATP 转为 AMP 和焦磷酸，推动合成。裂解酶催化可逆反应。精氨酸酶水解精氨酸生成尿素和鸟氨酸，在肝尿素循环中也向生成尿素的方向进行，C 的取舍取决于题目对“单向”的口径。", "explanationReferences": [{"title": "Reactome · 人体尿素循环", "url": "https://www.reactome.org/content/detail/R-HSA-70635"}]}], "lectureEvidence": {"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 56, "pageLabel": "带导图合集 · PDF第56页", "title": "生化带导图合集 · PDF第56页 · 氨基酸代谢与氨基酸", "image": "site-assets/biochemistry-collection/page-056.avif", "lectureId": "lecture-07", "lectureNumber": 7, "knowledgePoints": ["鸟氨酸循环各反应及 OCT 单向反应的标注"]}, "lectureEvidencePages": [{"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 56, "pageLabel": "带导图合集 · PDF第56页", "title": "生化带导图合集 · PDF第56页 · 氨基酸代谢与氨基酸", "image": "site-assets/biochemistry-collection/page-056.avif", "lectureId": "lecture-07", "lectureNumber": 7, "knowledgePoints": ["鸟氨酸循环各反应及 OCT 单向反应的标注"]}]},
