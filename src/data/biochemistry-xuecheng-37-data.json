  {"id": "xuecheng-37-20261114-q05", "topic": "糖异生", "title": "37不yy老师的学成选择题", "kindLabel": "多项选择", "sourceLabel": "37不yy老师的学成选择题", "sourceName": "11月14日学成选择题", "sourceSection": "11月14日", "sourceQuestion": 5, "questionAuthor": "37不yy", "supplement": true, "hideSource": true, "answerSourceLabel": "原稿答案", "lectureIds": ["lecture-03"], "chapterLectureIds": ["lecture-03"], "options": [{"key": "A", "label": "空腹饥饿时肝补充血糖"}, {"key": "B", "label": "通过三碳途径合成肝糖原和肌糖原"}, {"key": "C", "label": "长期饥饿时肾维持酸碱平衡"}, {"key": "D", "label": "避免乳酸堆积、损失能源物质"}], "stems": [{"text": "糖异生的意义包括：（多选）", "answer": ["A", "C"], "answerMode": "多选", "explanation": "空腹时肝糖异生补充血糖，长期饥饿时肾利用谷氨酰胺进行糖异生并排铵，有助于维持酸碱平衡。合集的三碳途径此处指补充肝糖原，B 把肌糖原也并列写入。D 描述的是乳酸循环的作用，合集放在乳酸作为糖异生原料一节。乳酸循环本身也包含肝糖异生，原稿按讲义条目取 A、C。"}], "lectureEvidence": {"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 17, "pageLabel": "带导图合集 · PDF第17页", "title": "生化带导图合集 · PDF第17页 · 磷酸戊糖途径、糖原、糖异生", "image": "site-assets/biochemistry-collection/page-017.avif", "lectureId": "lecture-03", "lectureNumber": 3, "knowledgePoints": ["饥饿时的肝糖异生、肾泌氨与乳酸循环"]}, "lectureEvidencePages": [{"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 17, "pageLabel": "带导图合集 · PDF第17页", "title": "生化带导图合集 · PDF第17页 · 磷酸戊糖途径、糖原、糖异生", "image": "site-assets/biochemistry-collection/page-017.avif", "lectureId": "lecture-03", "lectureNumber": 3, "knowledgePoints": ["饥饿时的肝糖异生、肾泌氨与乳酸循环"]}]},
