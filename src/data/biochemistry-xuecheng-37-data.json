  {"id": "xuecheng-37-20261115-q05", "topic": "脂代谢", "title": "37不yy老师的学成选择题", "kindLabel": "多项选择", "sourceLabel": "37不yy老师的学成选择题", "sourceName": "生化-脂肪代谢", "sourceSection": "11月15日", "sourceQuestion": 5, "questionAuthor": "37不yy", "supplement": true, "hideSource": true, "answerSourceLabel": "原稿答案", "lectureIds": ["lecture-06"], "chapterLectureIds": ["lecture-06"], "options": [{"key": "A", "label": "3-磷酸甘油"}, {"key": "B", "label": "甘油"}, {"key": "C", "label": "乙酰CoA"}, {"key": "D", "label": "甘油二酯"}], "stems": [{"text": "骨骼肌细胞合成脂肪的基本原料有：（多选）", "answer": ["A", "C"], "answerMode": "多选", "explanation": "题目问基本原料，按合集选 A、C。骨骼肌甘油激酶活性很低，主要将糖酵解生成的磷酸二羟丙酮转为 3-磷酸甘油，提供甘油骨架。乙酰 CoA 可提供从头合成脂肪酸的碳源，脂酰 CoA 再参与甘油三酯合成。甘油二酯是合成途中形成的中间产物。"}], "lectureEvidence": {"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 43, "pageLabel": "带导图合集 · PDF第43页", "title": "生化带导图合集 · PDF第43页 · 脂肪代谢", "image": "site-assets/biochemistry-collection/page-043.avif", "lectureId": "lecture-06", "lectureNumber": 6, "knowledgePoints": ["骨骼肌的3-磷酸甘油来源及脂肪酸合成原料"]}, "lectureEvidencePages": [{"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 43, "pageLabel": "带导图合集 · PDF第43页", "title": "生化带导图合集 · PDF第43页 · 脂肪代谢", "image": "site-assets/biochemistry-collection/page-043.avif", "lectureId": "lecture-06", "lectureNumber": 6, "knowledgePoints": ["骨骼肌的3-磷酸甘油来源及脂肪酸合成原料"]}, {"sourceSubject": "biochemistry", "sourceFile": "27生化跟课版合集【带导图】.pdf", "page": 44, "pageLabel": "带导图合集 · PDF第44页", "title": "生化带导图合集 · PDF第44页 · 脂肪代谢", "image": "site-assets/biochemistry-collection/page-044.avif", "lectureId": "lecture-06", "lectureNumber": 6, "knowledgePoints": ["甘油二酯途径合成甘油三酯"]}]},
